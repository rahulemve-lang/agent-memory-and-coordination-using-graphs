# Copy to .env and fill in. Never commit .env.
# Shared secret between n8n and the graphmem API (any long random string)
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GRAPHMEM_API_KEY=change-me
# Encrypts credentials stored inside n8n. Set once and keep it; changing it later
# makes existing n8n credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-too
# LLM keys (free tiers are fine)
GEMINI_API_KEY=
GROQ_API_KEY=
