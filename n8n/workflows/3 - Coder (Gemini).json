      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = ($json.text ?? $json.output ?? '').trim();\nconst blocked = out.startsWith('BLOCKED:');\nconst summary = (out.match(/^SUMMARY:\\s*(.+)$/m) || [])[1] || (blocked ? out : 'No summary');\nreturn { json: { blocked, summary, full: out } };"
      },
